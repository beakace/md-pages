# ============================================
# Formularz kontaktowy (sekcja Kontakt)
# Skopiuj do .env.local i wypełnij
# ============================================

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Nadawca (bez weryfikacji domeny: "Formularz <onboarding@resend.dev>")
FROM_EMAIL="mdpages <onboarding@resend.dev>"

# Odbiorca — gdzie trafiają wiadomości z formularza
CONTACT_EMAIL=twoj@email.pl

# Nazwa i URL strony (temat i stopka maila)
SITE_NAME="mdpages"
SITE_URL="mdpages.pl"

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=0x4AAA...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...
