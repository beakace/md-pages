# ============================================
# CONTACT FORM - KONFIGURACJA
# Skopiuj do .env.local i wypełnij
# ============================================

# RESEND (jedno konto dla wszystkich projektów)
# API key z https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Email nadawcy - wymaga zweryfikowanej domeny w Resend
# Bez weryfikacji użyj: "Formularz <onboarding@resend.dev>"
FROM_EMAIL="Nazwa Firmy <formularz@domena.pl>"

# Email odbiorcy - gdzie mają trafiać wiadomości
CONTACT_EMAIL=klient@email.pl

# Nazwa strony (pokazywana w temacie maila)
SITE_NAME="Nazwa Firmy"

# URL strony (pokazywany w stopce maila)
SITE_URL="domena.pl"

# ============================================
# CLOUDFLARE TURNSTILE (antyspam)
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# ============================================

# Secret key (backend) - NIE UDOSTĘPNIAJ!
TURNSTILE_SECRET_KEY=0x4AAA...

# Site key (frontend) - publiczny
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAA...
